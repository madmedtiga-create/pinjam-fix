<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PinjamBar • Supabase</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body class="bg-slate-50">

  <!-- LOGIN -->
  <div id="login-screen" class="min-h-screen flex items-center justify-center p-4">
    <div class="max-w-md w-full">
      <div class="text-center mb-8">
        <div class="mx-auto w-20 h-20 bg-blue-600 rounded-3xl flex items-center justify-center mb-4">
          <i class="fa-solid fa-handshake text-white text-5xl"></i>
        </div>
        <h1 class="text-4xl font-extrabold">PinjamBar</h1>
      </div>

      <div class="bg-white rounded-3xl shadow-xl p-8">
        <div class="mb-6">
          <h2 class="text-2xl font-bold">Masuk ke Akun</h2>
        </div>

        <div class="space-y-3 mb-6">
          <button onclick="quickLogin('admin','admin123')" class="w-full bg-slate-900 text-white py-3.5 rounded-2xl font-semibold flex justify-center items-center gap-x-2">
            <i class="fa-solid fa-user-shield"></i> Login sebagai Admin
          </button>
          <button onclick="quickLogin('budi','budi123')" class="w-full border py-3.5 rounded-2xl font-semibold flex justify-center items-center gap-x-2">
            <i class="fa-solid fa-user text-blue-600"></i> Login sebagai Budi
          </button>
        </div>

        <form onsubmit="handleLogin(event)">
          <div class="space-y-4">
            <div>
              <label class="text-xs font-bold">USERNAME</label>
              <input type="text" id="login-username" value="admin" class="w-full border px-4 py-3 rounded-2xl mt-1">
            </div>
            <div>
              <label class="text-xs font-bold">PASSWORD</label>
              <input type="password" id="login-password" value="admin123" class="w-full border px-4 py-3 rounded-2xl mt-1">
            </div>
          </div>
          <button type="submit" class="mt-6 w-full bg-blue-600 text-white py-3.5 rounded-2xl font-bold">MASUK</button>
        </form>
      </div>
    </div>
  </div>

  <!-- MAIN APP -->
  <div id="main-app" class="hidden max-w-screen-xl mx-auto">
    <!-- Top Bar -->
    <div class="bg-white border-b px-4 py-3 flex justify-between items-center sticky top-0 z-50">
      <div class="flex items-center gap-x-3">
        <div class="w-9 h-9 bg-blue-600 rounded-2xl flex items-center justify-center">
          <i class="fa-solid fa-handshake text-white"></i>
        </div>
        <span class="font-extrabold text-2xl">PinjamBar</span>
      </div>
      <div class="flex items-center gap-x-4">
        <div class="text-right">
          <div id="user-name" class="font-semibold text-sm"></div>
          <div id="user-role" class="text-xs text-slate-500"></div>
        </div>
        <button onclick="logout()" class="text-red-600 px-4 py-2 text-sm">Logout</button>
      </div>
    </div>

    <div class="p-4">
      <!-- ADMIN -->
      <div id="admin-view" class="hidden">
        <h1 class="text-2xl font-bold mb-6">Dashboard Admin</h1>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
          <div class="bg-white border rounded-3xl p-5"><div class="text-xs">TOTAL BARANG</div><div id="stat-items" class="text-3xl font-extrabold">0</div></div>
          <div class="bg-white border rounded-3xl p-5"><div class="text-xs">MENUNGGU</div><div id="stat-pending" class="text-3xl font-extrabold text-amber-600">0</div></div>
          <div class="bg-white border rounded-3xl p-5"><div class="text-xs">PINJAMAN AKTIF</div><div id="stat-active" class="text-3xl font-extrabold text-emerald-600">0</div></div>
          <div class="bg-white border rounded-3xl p-5"><div class="text-xs">TOTAL USER</div><div id="stat-users" class="text-3xl font-extrabold">0</div></div>
        </div>

        <div class="flex gap-x-2 mb-4">
          <button onclick="showAdminTab('items')" class="px-5 py-2 bg-white border rounded-2xl">Kelola Barang</button>
          <button onclick="showAdminTab('requests')" class="px-5 py-2 bg-white border rounded-2xl">Pinjaman Masuk</button>
          <button onclick="showAdminTab('history')" class="px-5 py-2 bg-white border rounded-2xl">Riwayat</button>
        </div>

        <!-- Items -->
        <div id="admin-items-tab">
          <div class="flex justify-between mb-3">
            <h3 class="font-bold">Daftar Barang</h3>
            <button onclick="showAddItemModal()" class="bg-blue-600 text-white px-4 h-9 rounded-2xl text-sm">+ Tambah</button>
          </div>
          <div class="bg-white border rounded-3xl overflow-hidden">
            <table class="w-full text-sm">
              <thead><tr class="border-b"><th class="px-5 py-3 text-left">Nama</th><th class="px-5 py-3 text-center">Stok</th><th class="px-5 py-3 text-right">Aksi</th></tr></thead>
              <tbody id="admin-items-table"></tbody>
            </table>
          </div>
        </div>

        <!-- Requests -->
        <div id="admin-requests-tab" class="hidden">
          <h3 class="font-bold mb-3">Pinjaman Menunggu</h3>
          <div id="admin-requests-list" class="space-y-3"></div>
        </div>

        <!-- History -->
        <div id="admin-history-tab" class="hidden">
          <h3 class="font-bold mb-3">Riwayat Peminjaman</h3>
          <div id="admin-history-list" class="space-y-2"></div>
        </div>
      </div>

      <!-- USER -->
      <div id="user-view" class="hidden">
        <h1 class="text-2xl font-bold mb-6">Daftar Barang</h1>
        <div id="user-items-grid" class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8"></div>

        <div class="bg-white border rounded-3xl p-5">
          <div class="font-bold mb-3">Keranjang Pinjaman</div>
          <div id="user-cart-list" class="space-y-2 mb-4 min-h-[50px]"></div>
          <button onclick="submitBorrowRequest()" class="w-full bg-emerald-600 text-white h-12 rounded-2xl font-extrabold">AJUKAN PEMINJAMAN</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const SUPABASE_URL = 'https://nzyamtfbetewfiahjwlh.supabase.co';
    const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im56eWFtdGZiZXRld2ZpYWhqd2xoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA3NjY1NTgsImV4cCI6MjA5NjM0MjU1OH0.G3QmiTGwJOStL0GapeeJGRwyEqSsFxjdHJP3zikqf0I';

    const supabase = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

    let currentUser = null;
    let currentCart = [];

    // ==================== AUTH ====================
    async function handleLogin(e) {
      e.preventDefault();
      const username = document.getElementById('login-username').value;
      const password = document.getElementById('login-password').value;

      const { data, error } = await supabase
        .from('users')
        .select('*')
        .eq('username', username)
        .eq('password', password)
        .single();

      if (error || !data) {
        alert('Username atau password salah');
        return;
      }
      currentUser = data;
      showMainApp();
    }

    function quickLogin(u, p) {
      document.getElementById('login-username').value = u;
      document.getElementById('login-password').value = p;
      document.querySelector('#login-screen form').dispatchEvent(new Event('submit'));
    }

    function showMainApp() {
      document.getElementById('login-screen').classList.add('hidden');
      document.getElementById('main-app').classList.remove('hidden');
      document.getElementById('user-name').innerText = currentUser.username;
      document.getElementById('user-role').innerText = currentUser.role.toUpperCase();

      if (currentUser.role === 'admin') {
        document.getElementById('admin-view').classList.remove('hidden');
        document.getElementById('user-view').classList.add('hidden');
        loadAdminDashboard();
      } else {
        document.getElementById('admin-view').classList.add('hidden');
        document.getElementById('user-view').classList.remove('hidden');
        loadUserMarketplace();
      }
    }

    function logout() {
      currentUser = null;
      currentCart = [];
      location.reload();
    }

    // ==================== ADMIN ====================
    async function loadAdminDashboard() {
      const { data: items } = await supabase.from('items').select('*');
      const { data: requests } = await supabase.from('borrow_requests').select('*');

      document.getElementById('stat-items').innerText = items?.length || 0;
      document.getElementById('stat-pending').innerText = requests?.filter(r => r.status === 'pending').length || 0;
      document.getElementById('stat-active').innerText = requests?.filter(r => r.status === 'approved').length || 0;

      renderAdminItems(items);
    }

    function renderAdminItems(items) {
      const tbody = document.getElementById('admin-items-table');
      tbody.innerHTML = '';
      items.forEach(item => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="px-5 py-3">${item.name}</td>
          <td class="px-5 py-3 text-center">${item.stock}</td>
          <td class="px-5 py-3 text-right">
            <button onclick="deleteItem(${item.id})" class="text-xs px-3 h-8 text-red-600">Hapus</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function showAdminTab(tab) {
      document.getElementById('admin-items-tab').classList.add('hidden');
      document.getElementById('admin-requests-tab').classList.add('hidden');
      document.getElementById('admin-history-tab').classList.add('hidden');

      if (tab === 'items') document.getElementById('admin-items-tab').classList.remove('hidden');
      if (tab === 'requests') loadAdminRequests();
      if (tab === 'history') loadAdminHistory();
    }

    async function loadAdminRequests() {
      const container = document.getElementById('admin-requests-list');
      container.innerHTML = '';

      const { data: requests } = await supabase.from('borrow_requests').select('*').eq('status', 'pending');

      if (!requests || requests.length === 0) {
        container.innerHTML = `<div class="text-center py-8 text-slate-400">Tidak ada pengajuan</div>`;
        return;
      }

      requests.forEach(req => {
        const div = document.createElement('div');
        div.className = 'bg-white border border-amber-200 rounded-3xl p-5';
        div.innerHTML = `
          <div class="flex justify-between mb-3">
            <span class="font-bold">${req.username}</span>
            <span class="text-xs px-3 py-1 bg-amber-100 text-amber-700 rounded-2xl">MENUNGGU</span>
          </div>
          <div class="text-sm mb-4">${req.items.map(i => i.name + ' ×' + i.qty).join('<br>')}</div>
          <div class="flex gap-x-3">
            <button onclick="approveRequest('${req.id}')" class="flex-1 h-10 bg-emerald-600 text-white rounded-2xl text-sm font-bold">SETUJUI</button>
            <button onclick="rejectRequest('${req.id}')" class="flex-1 h-10 border text-red-600 border-red-200 rounded-2xl text-sm font-bold">TOLAK</button>
          </div>
        `;
        container.appendChild(div);
      });
    }

    async function loadAdminHistory() {
      const container = document.getElementById('admin-history-list');
      container.innerHTML = '';

      const { data: requests } = await supabase.from('borrow_requests').select('*').order('request_date', { ascending: false });

      requests.forEach(req => {
        const div = document.createElement('div');
        div.className = 'bg-white border rounded-3xl p-4 text-sm flex justify-between';
        div.innerHTML = `
          <div>
            <span class="font-semibold">${req.username}</span> - 
            <span class="text-xs">${req.status}</span>
          </div>
          <div class="text-xs text-slate-400">${new Date(req.request_date).toLocaleDateString('id-ID')}</div>
        `;
        container.appendChild(div);
      });
    }

    // ==================== USER ====================
    async function loadUserMarketplace() {
      const grid = document.getElementById('user-items-grid');
      grid.innerHTML = '';

      const { data: items } = await supabase.from('items').select('*');

      items.forEach(item => {
        const card = document.createElement('div');
        card.className = 'bg-white border rounded-3xl overflow-hidden';
        card.innerHTML = `
          <div class="p-4">
            <div class="font-extrabold">${item.name}</div>
            <div class="text-emerald-600 text-sm">Stok: ${item.stock}</div>
            <button onclick="addToCart(${item.id}, '${item.name}', ${item.stock})" class="mt-3 w-full h-9 bg-blue-600 text-white text-sm rounded-2xl">TAMBAH KE KERANJANG</button>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    function addToCart(id, name, stock) {
      const existing = currentCart.find(c => c.id === id);
      if (existing) existing.qty++;
      else currentCart.push({ id, name, qty: 1 });
      renderCart();
    }

    function renderCart() {
      const container = document.getElementById('user-cart-list');
      container.innerHTML = '';
      currentCart.forEach((item, index) => {
        const div = document.createElement('div');
        div.className = 'flex justify-between bg-slate-50 px-4 py-2 rounded-2xl text-sm';
        div.innerHTML = `
          <span>${item.name} ×${item.qty}</span>
          <button onclick="removeFromCart(${index})" class="text-red-400">×</button>
        `;
        container.appendChild(div);
      });
    }

    function removeFromCart(index) {
      currentCart.splice(index, 1);
      renderCart();
    }

    async function submitBorrowRequest() {
      if (currentCart.length === 0) return;

      const { error } = await supabase.from('borrow_requests').insert({
        id: 'REQ' + Date.now(),
        user_id: currentUser.id,
        username: currentUser.username,
        items: currentCart,
        status: 'pending',
        request_date: new Date()
      });

      if (error) {
        alert('Gagal mengajukan');
        return;
      }
      alert('Pengajuan berhasil dikirim!');
      currentCart = [];
      renderCart();
    }

    // ==================== ADMIN ACTIONS ====================
    async function approveRequest(requestId) {
      await supabase.from('borrow_requests').update({ status: 'approved' }).eq('id', requestId);
      loadAdminRequests();
    }

    async function rejectRequest(requestId) {
      await supabase.from('borrow_requests').update({ status: 'rejected' }).eq('id', requestId);
      loadAdminRequests();
    }

    function showAddItemModal() {
      const name = prompt('Nama barang:');
      const stock = prompt('Stok:', '1');
      if (!name) return;

      supabase.from('items').insert({ name, stock: parseInt(stock) })
        .then(() => {
          alert('Barang ditambahkan');
          loadAdminDashboard();
        });
    }

    async function deleteItem(id) {
      if (!confirm('Hapus barang?')) return;
      await supabase.from('items').delete().eq('id', id);
      loadAdminDashboard();
    }

    // ==================== INIT ====================
    function init() {
      console.log('%c[PinjamBar] Supabase version loaded', 'color:#64748b');
    }
    window.onload = init;
  </script>
</body>
</html>
